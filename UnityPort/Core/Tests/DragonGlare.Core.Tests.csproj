<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../DragonGlareAlpha.Tests/*.cs" />
    <Compile Include="SaveCompatibilityTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="../DragonGlare.Core.csproj" />
    <!-- Compile original save code without depending on local-only presentation assets. -->
    <ProjectReference Include="../../../DragonGlareAlpha.csproj" ReferenceOutputAssembly="false" AdditionalProperties="ApplicationIcon=;CustomAfterMicrosoftCommonTargets=$(MSBuildThisFileDirectory)OriginalSaveCompatibility.targets" />
    <Reference Include="DragonGlare Beta">
      <HintPath>../../../bin/$(Configuration)/net10.0-windows10.0.17763.0/win-x64/DragonGlare Beta.dll</HintPath>
      <Aliases>monogame</Aliases>
    </Reference>
  </ItemGroup>
</Project>
